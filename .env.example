# MSSQL campaign database.
MSSQL_SERVER=sqlserver.example.com
MSSQL_PORT=1433
MSSQL_DATABASE=CampaignDb
MSSQL_USERNAME=campaign_user
MSSQL_PASSWORD=replace-with-password
MSSQL_LOGIN_TIMEOUT=10
MSSQL_SCHEMA=marketing

# SEGMA API used to list segments, list seed ActionDatasets, and create syncs.
SEGMA_API=https://segma.example.com
SEGMA_TOKEN=replace-with-segma-token
SEGMA_USER_ID=7
MSSQL_DESTINATION_ID=45
SEGMA_SYNC_CHUNKSIZE=1000

# Optional fallback if SEGMA /api/v1/segments is unavailable.
# SEGMA_SEGMENTS_JSON=[{"label":"VIP Customers","source_id":123,"source_name":"vip_customers"}]
# Or configure a single fallback segment with the curl-style ACTION_DATASET_ID variables.
# ACTION_DATASET_ID=123
# ACTION_DATASET_NAME=VIP Customers

# Optional per-channel destination overrides. If omitted, MSSQL_DESTINATION_ID is used.
SEGMA_EDM_DESTINATION_ID=45
SEGMA_SMS_DESTINATION_ID=45
SEGMA_APP_DESTINATION_ID=45

# Provider credentials used by the console's real test-send buttons.
SENDGRID_API_BASE_URL=https://api.sendgrid.com
SENDGRID_API_KEY=replace-with-sendgrid-api-key
EDM_DEFAULT_SENDER_EMAIL=marketing@example.com

TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
SMS_DEFAULT_SENDER_NUMBER=+15551234567

# APP notification application rows in MSSQL reference env names like this
# through marketing.app_notification_application.azure_connection_secret_name.
CAPITAL_MOBILE_AZURE_CONNECTION_STRING=Endpoint=sb://namespace.servicebus.windows.net/;SharedAccessKeyName=DefaultFullSharedAccessSignature;SharedAccessKey=replace-with-key
